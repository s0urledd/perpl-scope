{
  "name": "perpl-scope",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "check": "node --check src/*.js scripts/*.js web/*.js web/views/*.js",
    "validate": "node --env-file-if-exists=.env src/cli.js",
    "validate:math": "node --env-file-if-exists=.env scripts/validate-math.js",
    "snapshot": "node --env-file=.env src/snapshot.js"
  },
  "dependencies": {
    "viem": "2.56.3"
  },
  "description": "Independent risk analytics for Perpl on Monad: liquidation exposure, open interest and funding computed from chain state.",
  "license": "MIT"
}
