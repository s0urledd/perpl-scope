# User-supplied read-only Monad RPC. Never commit credentials.
MONAD_RPC_URL=
CHAIN_ID=143
EXCHANGE_ADDRESS=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
# Optional standard JSON-RPC WebSocket endpoint.
MONAD_WSS_URL=
# Event index (volume, fees, flows, wallet history). Defaults suit a node that
# allows 1000-block eth_getLogs ranges; public RPCs need INDEX_LOG_RANGE=100.
# INDEX_BLOCKS=2100000        # raw window, about 7 days at 0.3 s blocks
# INDEX_LOG_RANGE=1000        # blocks per eth_getLogs request during backfill
# INDEX_CONCURRENCY=4         # parallel backfill requests
# INDEX_PATH=data/index.json  # hourly aggregates persisted across restarts
